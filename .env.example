# מצפן — משתני סביבה
# בשלב ה-MVP הנוכחי (mock auth, מאגר חברות סטטי) אין באמת סודות נדרשים.
# הקובץ הזה ממחיש מה יידרש ברגע שמחברים אינטגרציות אמיתיות (PRD סעיפים 6.1, 7.1, 9.2):

# --- Session ---
MATZPEN_SECRET_KEY=change-me-to-a-random-string
PORT=8420

# --- שלב הבא: Google OAuth אמיתי (מחליף את /api/auth/mock-login) ---
# נוצר ב-Google Cloud Console אחרי הרשמת אפליקציה + עמידה בתהליך האימות
# המתואר ב-PRD סעיף 9.2 (כולל CASA Security Assessment).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8420/api/auth/google/callback

# --- שלב הבא: מאגר חברות חי (מחליף את company_pool הסטטי ב-db.py) ---
# COMPANY_DATA_API_KEY=
# COMPANY_DATA_PROVIDER=harmonic   # harmonic | crunchbase | apollo

# --- שלב הבא: מנוע המלצות V2 (LLM-assisted, ראו PRD סעיף 7.3) ---
# ANTHROPIC_API_KEY=

# --- שלב הבא: בסיס נתונים בפרודקשן ---
# DATABASE_URL=postgresql://user:pass@host:5432/matzpen
